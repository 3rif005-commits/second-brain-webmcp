# Supabase — get these from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google AI — https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key

# FastAPI backend (Phase 2+)
FASTAPI_URL=http://localhost:8000

# Notion-databases feature flag. Mirrors the backend's
# `core/config.py: settings.database_rows_enabled`. Migration 014
# (db_row_props) and migration 019 (the notes_excluding_database_rows view)
# are both applied in production, and the notes routes now query that view
# when this is "true" (see frontend/lib/database/notesExclusion.ts) — safe
# to flip to true once the code change that reads the view is deployed.
DATABASE_ROWS_ENABLED=false
